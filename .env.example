VITE_FE_PORT=9100

# 构建期：CAM-FE 的公网根地址（末尾必须保留 /）。
# 作为 CDI-Pedestal 微前端时必须设置，否则清单会将资源解析到主站域名。
VITE_CAM_PUBLIC_BASE_URL=https://cam-fe-production-<service-id>.up.railway.app/

# 原始后端 Base URL（被 Vite/Caddy 代理至 /api）
CAM_UPSTREAM_BASE_URL=<cam_upstream_base_url>

# 覆盖默认 i18n 文案。必须是单行合法 JSON；只会覆盖已有的字符串 key。
# VITE_CONTENT_OVERRIDE='{"en-US":{"service":{"title":"CAM API Management"}},"zh-CN":{"service":{"title":"CAM API 管理"}}}'
